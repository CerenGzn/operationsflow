# Synthetic local development only. Replace the placeholder in your ignored .env.
POSTGRES_DB=operationsflow
POSTGRES_USER=operationsflow
POSTGRES_PASSWORD=replace-with-local-only-password
DB_URL=jdbc:postgresql://localhost:5432/operationsflow
DB_USERNAME=operationsflow
# Keep this equal to POSTGRES_PASSWORD for host-based backend development.
DB_PASSWORD=replace-with-local-only-password
