# Synthetic local development only. Replace the placeholder in your ignored .env.
POSTGRES_DB=operationsflow
POSTGRES_USER=operationsflow
POSTGRES_PASSWORD=replace-with-local-only-password
DB_URL=jdbc:postgresql://localhost:5432/operationsflow
DB_USERNAME=operationsflow
# Keep this equal to POSTGRES_PASSWORD for host-based backend development.
DB_PASSWORD=replace-with-local-only-password
# Local HTTP only. Require true when running behind properly configured HTTPS.
SESSION_COOKIE_SECURE=false
# One-time bootstrap: supply BOOTSTRAP_ADMIN_EMAIL and BOOTSTRAP_ADMIN_PASSWORD
# securely in the backend process environment, then unset after initialization.
# Never store a bootstrap password in this file. See docs/milestone-5.md.

# Optional local messaging only; replace these placeholders in your ignored .env.
RABBITMQ_USERNAME=local-messaging
RABBITMQ_PASSWORD=replace-with-local-only-rabbit-password
